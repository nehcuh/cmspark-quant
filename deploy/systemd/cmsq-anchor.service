[Unit]
Description=publish cmsq audit head to the anchor git repo (signed commit, push)
# /srv/cmsq-anchors = clone of github.com/nehcuh/cmspark-quant-anchors (private), with
# git config gpg.format=ssh, user.signingkey=<anchor signing key .pub>, push credentials
[Service]
Type=oneshot
User=cmsq
Environment=CMSQ_AUDIT_SIGNER=/run/cmsq-signer/sock
ExecStart=/usr/local/bin/cmsq --home /srv/cmsq audit anchor-git --repo /srv/cmsq-anchors --sign --push
ExecStartPost=/usr/local/bin/cmsq --home /srv/cmsq audit verify-git --repo /srv/cmsq-anchors
